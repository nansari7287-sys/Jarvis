<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#0A1725"/>
            <stroke
                android:width="2dp"
                android:color="@color/jarvis_accent"/>
            <corners android:radius="30dp"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A1522"/>
            <stroke
                android:width="1dp"
                android:color="#0085A0"/>
            <corners android:radius="30dp"/>
        </shape>
    </item>

</selector>