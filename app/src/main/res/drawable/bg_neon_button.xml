<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BUTTON PRESSED -->
    <item android:state_pressed="true">

        <shape android:shape="rectangle">

            <solid android:color="#12384A"/>

            <stroke
                android:width="2dp"
                android:color="#00E5FF"/>

            <corners
                android:radius="22dp"/>

            <padding
                android:left="8dp"
                android:top="4dp"
                android:right="8dp"
                android:bottom="4dp"/>

        </shape>

    </item>


    <!-- NORMAL -->
    <item>

        <shape android:shape="rectangle">

            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#0B1D2B"
                android:centerColor="#06131F"
                android:endColor="#020A12"/>

            <stroke
                android:width="1dp"
                android:color="#008EAC"/>

            <corners
                android:radius="22dp"/>

            <padding
                android:left="8dp"
                android:top="4dp"
                android:right="8dp"
                android:bottom="4dp"/>

        </shape>

    </item>

</selector>