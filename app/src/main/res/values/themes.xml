<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- MASTER THEME                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <style name="Theme.Jarvis" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- PRIMARY -->
        <item name="colorPrimary">@color/jarvis_accent</item>
        <item name="colorPrimaryVariant">@color/jarvis_accent_2</item>
        <item name="colorOnPrimary">@color/jarvis_background</item>

        <!-- SECONDARY -->
        <item name="colorSecondary">@color/jarvis_neon_purple</item>
        <item name="colorSecondaryVariant">@color/jarvis_neon_pink</item>
        <item name="colorOnSecondary">@color/jarvis_background</item>

        <!-- ERROR -->
        <item name="colorError">@color/jarvis_error</item>
        <item name="colorOnError">@color/jarvis_text_primary</item>

        <!-- SURFACES -->
        <item name="android:colorBackground">@color/jarvis_background</item>
        <item name="colorOnBackground">@color/jarvis_text_primary</item>
        <item name="colorSurface">@color/jarvis_surface</item>
        <item name="colorOnSurface">@color/jarvis_text_primary</item>
        <item name="colorSurfaceVariant">@color/jarvis_surface_2</item>

        <!-- SYSTEM BARS -->
        <item name="android:windowBackground">@color/jarvis_background</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/navigation_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- TYPOGRAPHY -->
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColorPrimary">@color/jarvis_text_primary</item>
        <item name="android:textColorSecondary">@color/jarvis_text_secondary</item>
        <item name="android:textColorHint">@color/jarvis_text_tertiary</item>

        <!-- COMPONENTS -->
        <item name="materialButtonStyle">@style/Widget.Jarvis.Button</item>
        <item name="textInputStyle">@style/Widget.Jarvis.TextInputLayout</item>
        <item name="materialAlertDialogTheme">@style/Theme.Jarvis.Dialog</item>
        <item name="toolbarStyle">@style/Widget.Jarvis.Toolbar</item>
        <item name="cardViewStyle">@style/Widget.Jarvis.CardView</item>

        <!-- SYSTEM -->
        <item name="android:soundEffectsEnabled">false</item>

    </style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- BUTTON STYLES                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <style name="Widget.Jarvis.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/jarvis_accent</item>
        <item name="android:textColor">@color/jarvis_background</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="cornerRadius">4dp</item>
        <item name="rippleColor">@color/ripple_accent</item>
    </style>

    <style name="Widget.Jarvis.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/jarvis_accent</item>
        <item name="strokeColor">@color/jarvis_accent</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">4dp</item>
    </style>

    <style name="Widget.Jarvis.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/jarvis_accent</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- TEXT INPUT                                                           -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <style name="Widget.Jarvis.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/jarvis_accent</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxBackgroundColor">@color/jarvis_surface</item>
        <item name="hintTextColor">@color/jarvis_accent</item>
        <item name="android:textColorHint">@color/jarvis_text_tertiary</item>
        <item name="boxCornerRadiusTopStart">6dp</item>
        <item name="boxCornerRadiusTopEnd">6dp</item>
        <item name="boxCornerRadiusBottomStart">6dp</item>
        <item name="boxCornerRadiusBottomEnd">6dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- DIALOG                                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <style name="Theme.Jarvis.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/jarvis_surface</item>
        <item name="colorOnSurface">@color/jarvis_text_primary</item>
        <item name="colorPrimary">@color/jarvis_accent</item>
        <item name="android:textColorPrimary">@color/jarvis_text_primary</item>
        <item name="android:textColorSecondary">@color/jarvis_text_secondary</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- TOOLBAR                                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <style name="Widget.Jarvis.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/jarvis_surface</item>
        <item name="titleTextColor">@color/jarvis_accent</item>
        <item name="subtitleTextColor">@color/jarvis_text_secondary</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- CARD VIEW                                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <style name="Widget.Jarvis.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/jarvis_surface</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="strokeColor">@color/jarvis_divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- TEXT APPEARANCE                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <style name="TextAppearance.Jarvis.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/jarvis_text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.Jarvis.Terminal" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/jarvis_accent</item>
        <item name="android:shadowColor">@color/jarvis_accent</item>
        <item name="android:shadowRadius">4.0</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="TextAppearance.Jarvis.HUD" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/jarvis_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.3</item>
        <item name="android:shadowColor">@color/jarvis_accent</item>
        <item name="android:shadowRadius">20.0</item>
    </style>

    <style name="TextAppearance.Jarvis.Status" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/jarvis_success</item>
        <item name="android:letterSpacing">0.2</item>
    </style>

    <style name="TextAppearance.Jarvis.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/jarvis_text_tertiary</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- OTHER THEMES                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <style name="Theme.Jarvis.Splash" parent="Theme.Jarvis">
        <item name="android:windowBackground">@color/jarvis_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.Jarvis.Transparent" parent="Theme.Jarvis">
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Jarvis.Fullscreen" parent="Theme.Jarvis">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

</resources>