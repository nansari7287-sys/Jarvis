<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/jarvis_background"
    android:fitsSystemWindows="true">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/bg_neon_button">

        <ImageView
            android:id="@+id/logoView"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/jarvis_logo"
            android:contentDescription="@string/assistant_name"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JARVIS"
                android:textColor="@color/jarvis_accent"
                android:textSize="23sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR AI ASSISTANT"
                android:textColor="@color/jarvis_text_primary"
                android:textSize="10sp"
                android:letterSpacing="0.12"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● ONLINE • READY TO ASSIST"
                android:textColor="@color/jarvis_success"
                android:textSize="9sp"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <!-- Search -->
        <TextView
            android:id="@+id/searchButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="⌕"
            android:textColor="@color/jarvis_accent"
            android:textSize="29sp"
            android:background="@drawable/bg_neon_button"
            android:clickable="true"
            android:focusable="true"/>

        <!-- History -->
        <TextView
            android:id="@+id/historyButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="7dp"
            android:gravity="center"
            android:text="◷"
            android:textColor="@color/jarvis_accent"
            android:textSize="25sp"
            android:background="@drawable/bg_neon_button"
            android:clickable="true"
            android:focusable="true"/>

        <!-- SETTINGS -->
        <TextView
            android:id="@+id/settingsButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="7dp"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@color/jarvis_accent"
            android:textSize="25sp"
            android:background="@drawable/bg_neon_button"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>


    <!-- NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="7dp"
        android:background="@drawable/bg_neon_button">

        <TextView
            android:id="@+id/chatTab"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂  Chat"
            android:textColor="@color/jarvis_text_primary"
            android:textSize="14sp"
            android:background="@drawable/bg_neon_button"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/toolsTab"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="▦  Tools"
            android:textColor="@color/jarvis_text_primary"
            android:textSize="14sp"
            android:background="@drawable/bg_neon_button"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/assistTab"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="✦  Assist"
            android:textColor="@color/jarvis_text_primary"
            android:textSize="14sp"
            android:background="@drawable/bg_neon_button"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/menuButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="☰  Menu"
            android:textColor="@color/jarvis_text_primary"
            android:textSize="14sp"
            android:background="@drawable/bg_neon_button"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>


    <!-- CHAT -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messageRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="10dp"
        android:scrollbars="none"/>


    <!-- JARVIS CORE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="115dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:gravity="center"
            android:text="◉"
            android:textColor="@color/jarvis_accent"
            android:textSize="55sp"
            android:background="@drawable/bg_neon_button"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="J A R V I S"
            android:textColor="@color/jarvis_accent"
            android:textSize="14sp"
            android:letterSpacing="0.35"
            android:layout_marginTop="2dp"/>
    </LinearLayout>


    <!-- QUICK ACTIONS -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:scrollbars="none"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/webButton"
                android:layout_width="82dp"
                android:layout_height="68dp"
                android:gravity="center"
                android:text="◎\nWeb"
                android:textColor="@color/jarvis_text_primary"
                android:textSize="13sp"
                android:background="@drawable/bg_neon_button"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/youtubeButton"
                android:layout_width="82dp"
                android:layout_height="68dp"
                android:layout_marginStart="7dp"
                android:gravity="center"
                android:text="▶\nYouTube"
                android:textColor="@color/jarvis_text_primary"
                android:textSize="13sp"
                android:background="@drawable/bg_neon_button"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/instagramButton"
                android:layout_width="82dp"
                android:layout_height="68dp"
                android:layout_marginStart="7dp"
                android:gravity="center"
                android:text="◎\nInstagram"
                android:textColor="@color/jarvis_text_primary"
                android:textSize="13sp"
                android:background="@drawable/bg_neon_button"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/whatsappButton"
                android:layout_width="82dp"
                android:layout_height="68dp"
                android:layout_marginStart="7dp"
                android:gravity="center"
                android:text="◉\nWhatsApp"
                android:textColor="@color/jarvis_text_primary"
                android:textSize="13sp"
                android:background="@drawable/bg_neon_button"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/appsButton"
                android:layout_width="82dp"
                android:layout_height="68dp"
                android:layout_marginStart="7dp"
                android:gravity="center"
                android:text="▦\nApps"
                android:textColor="@color/jarvis_text_primary"
                android:textSize="13sp"
                android:background="@drawable/bg_neon_button"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/moreButton"
                android:layout_width="82dp"
                android:layout_height="68dp"
                android:layout_marginStart="7dp"
                android:gravity="center"
                android:text="•••\nMore"
                android:textColor="@color/jarvis_text_primary"
                android:textSize="13sp"
                android:background="@drawable/bg_neon_button"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </HorizontalScrollView>


    <!-- INPUT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp">

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="Ask JARVIS anything..."
            android:textColor="@color/jarvis_text_primary"
            android:textColorHint="@color/jarvis_text_secondary"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"/>

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="5dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_mic"
            android:contentDescription="@string/microphone"/>

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_neon_button"
            android:src="@drawable/ic_send"
            android:contentDescription="@string/send"/>
    </LinearLayout>

</LinearLayout>