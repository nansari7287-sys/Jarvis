<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/jarvis_background"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- ======================================================= -->
    <!-- HEADER SECTION : STATUS & CONTROLS                      -->
    <!-- ======================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/bg_neon_button"
        android:elevation="8dp">

        <!-- App Logo -->
        <ImageView
            android:id="@+id/headerLogo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/jarvis_logo"
            android:contentDescription="JARVIS Core Logo"
            android:scaleType="centerCrop"/>

        <!-- System Status Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="J.A.R.V.I.S."
                android:textColor="@color/jarvis_accent"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:shadowColor="@color/jarvis_accent"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INTELLIGENT SYSTEM CORE"
                android:textColor="@color/jarvis_text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-condensed"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">
                
                <!-- Blinking Online Dot (Can be animated in Kotlin) -->
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_input"
                    android:backgroundTint="@color/jarvis_success"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="SYSTEM ONLINE • READY"
                    android:textColor="@color/jarvis_success"
                    android:textSize="9sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Header Action Buttons -->
        <ImageButton
            android:id="@+id/searchButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_search"
            app:tint="@color/jarvis_accent"
            android:contentDescription="Search Network"/>

        <ImageButton
            android:id="@+id/historyButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_recent_history"
            app:tint="@color/jarvis_accent"
            android:contentDescription="History Log"/>

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:padding="10dp"
            android:contentDescription="System Settings"/>
    </LinearLayout>

    <!-- ======================================================= -->
    <!-- NAVIGATION TABS                                         -->
    <!-- ======================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="6dp"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/chatTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂ CHAT"
            android:textColor="@color/jarvis_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:background="@drawable/bg_neon_button"
            android:foreground="?attr/selectableItemBackground"/>

        <TextView
            android:id="@+id/toolsTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="▦ TOOLS"
            android:textColor="@color/jarvis_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:background="@drawable/bg_neon_button"
            android:foreground="?attr/selectableItemBackground"/>

        <TextView
            android:id="@+id/assistTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="✦ ASSIST"
            android:textColor="@color/jarvis_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:background="@drawable/bg_neon_button"
            android:foreground="?attr/selectableItemBackground"/>
    </LinearLayout>

    <!-- ======================================================= -->
    <!-- CHAT INTERFACE (DYNAMIC CONTENT AREA)                   -->
    <!-- ======================================================= -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messageRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp"
        android:scrollbars="none"
        tools:listitem="@android:layout/simple_list_item_1"/>

    <!-- ======================================================= -->
    <!-- JARVIS CORE (ROTATING NEON ORB)                         -->
    <!-- ======================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:layout_width="110dp"
            android:layout_height="110dp">
            
            <!-- Custom Rotating Arc Reactor View -->
            <com.example.jarvis.ui.JarvisOrbView
                android:id="@+id/jarvisOrbView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="JARVIS Core Engine"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="C O R E   A C T I V E"
            android:textColor="@color/jarvis_accent"
            android:textSize="11sp"
            android:letterSpacing="0.4"
            android:textStyle="bold"
            android:shadowColor="@color/jarvis_accent"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12"/>
    </LinearLayout>

    <!-- ======================================================= -->
    <!-- QUICK ACTION MODULES (HORIZONTAL SCROLL)                -->
    <!-- ======================================================= -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/webButton"
                android:layout_width="75dp"
                android:layout_height="65dp"
                android:gravity="center"
                android:text="◎\nWEB"
                android:textColor="@color/jarvis_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_neon_button"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/youtubeButton"
                android:layout_width="75dp"
                android:layout_height="65dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="▶\nMEDIA"
                android:textColor="@color/jarvis_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_neon_button"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/instagramButton"
                android:layout_width="75dp"
                android:layout_height="65dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="◈\nSOCIAL"
                android:textColor="@color/jarvis_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_neon_button"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/whatsappButton"
                android:layout_width="75dp"
                android:layout_height="65dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="💬\nCHAT"
                android:textColor="@color/jarvis_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_neon_button"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/appsButton"
                android:layout_width="75dp"
                android:layout_height="65dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="▦\nAPPS"
                android:textColor="@color/jarvis_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_neon_button"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ======================================================= -->
    <!-- INPUT TERMINAL (TEXT & VOICE)                           -->
    <!-- ======================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:background="#02040A">

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="Awaiting command sequence..."
            android:textColor="@color/jarvis_text_primary"
            android:textColorHint="@color/jarvis_text_secondary"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textSize="15sp"
            android:fontFamily="sans-serif"/>

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_neon_button"
            android:foreground="?attr/selectableItemBackground"
            android:src="@drawable/ic_mic"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:contentDescription="Voice Command Activation"/>

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_neon_button"
            android:foreground="?attr/selectableItemBackground"
            android:src="@drawable/ic_send"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:contentDescription="Execute Command"/>
    </LinearLayout>

</LinearLayout>
