<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="16dp">

    <!-- ========================================================= -->
    <!-- MAIN FUTURISTIC CAPSULE (JARVIS HUD)                      -->
    <!-- ========================================================= -->
    <LinearLayout
        android:id="@+id/jarvisHudContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:background="#E6050914"
        android:elevation="24dp"
        android:gravity="center"
        android:orientation="vertical"
        android:outlineAmbientShadowColor="#00E5FF"
        android:outlineSpotShadowColor="#00E5FF"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        tools:targetApi="p"> <!-- Requires Android P (API 28+) for Neon Glow Shadow -->

        <!-- TOP BAR: Status & Active Core -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Glowing AI Eye / Dot -->
            <View
                android:id="@+id/overlayDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="12dp"
                android:background="#00E5FF"
                android:elevation="10dp"
                android:outlineSpotShadowColor="#00E5FF"
                tools:targetApi="p" />

            <!-- Main Status Text -->
            <TextView
                android:id="@+id/overlayStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.15"
                android:shadowColor="#00E5FF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="25"
                android:text="J.A.R.V.I.S. ONLINE"
                android:textAllCaps="true"
                android:textColor="#00E5FF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- MIDDLE BAR: AI Voice Visualizer (Mockup for Tech Look) -->
        <LinearLayout
            android:id="@+id/audioVisualizer"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View android:layout_width="3dp" android:layout_height="8dp" android:layout_marginEnd="3dp" android:background="#00E5FF" />
            <View android:layout_width="3dp" android:layout_height="16dp" android:layout_marginEnd="3dp" android:background="#00E5FF" />
            <View android:layout_width="3dp" android:layout_height="20dp" android:layout_marginEnd="3dp" android:background="#00E5FF" />
            <View android:layout_width="3dp" android:layout_height="12dp" android:layout_marginEnd="3dp" android:background="#00E5FF" />
            <View android:layout_width="3dp" android:layout_height="6dp" android:background="#00E5FF" />
        </LinearLayout>

        <!-- DIVIDER LINE -->
        <View
            android:layout_width="180dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="#4D00E5FF" />

        <!-- ========================================================= -->
        <!-- CREATOR & ARCHITECT CREDITS (GLOWING WATERMARK)           -->
        <!-- ========================================================= -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:shadowColor="#00E5FF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="15"
                android:text="ARCHITECT: 𝑫𝒓𝒂𝒌𝒐𝑿𝑵𝒂𝒆𝒆𝒎"
                android:textColor="#B300E5FF"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.2"
                android:shadowColor="#FFFFFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:text="DEVELOPED BY 𝑵𝒂𝒆𝒆𝒎"
                android:textColor="#99FFFFFF"
                android:textSize="8sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>