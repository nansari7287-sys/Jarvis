<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!--                                                                           -->
<!--   J.A.R.V.I.S. TITAN ACCESSIBILITY SERVICE CONFIGURATION                  -->
<!--                                                                           -->
<!--   Universal Screen Control Engine - Enables AI-powered automation         -->
<!--   across ALL apps on the device (Instagram, YouTube, WhatsApp, etc.)      -->
<!--                                                                           -->
<!--   ⚠️  CRITICAL: This config determines what the accessibility service     -->
<!--       can see and control on the screen.                                  -->
<!--                                                                           -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->

<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"

    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <!-- DESCRIPTION (User Settings me dikhta hai)                              -->
    <!-- ═════════════════════════════════════════════════════════════════════ -->
    android:description="@string/accessibility_service_description"
    android:summary="@string/accessibility_service_summary"

    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <!-- EVENT TYPES - Kya kya monitor karega                                   -->
    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <!-- typeAllMask = Saare events capture karega                              -->
    <!-- Isse best control milta hai                                            -->
    android:accessibilityEventTypes="typeAllMask"

    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <!-- ACCESSIBILITY FLAGS - Advanced control capabilities                    -->
    <!-- ═════════════════════════════════════════════════════════════════════ -->
    android:accessibilityFlags="
        flagDefault|
        flagIncludeNotImportantViews|
        flagRequestFilterKeyEvents|
        flagReportViewIds|
        flagRetrieveInteractiveWindows|
        flagRequestEnhancedWebAccessibility|
        flagRequestTouchExplorationMode|
        flagRequestAccessibilityButton|
        flagSendAccessibilityEvents|
        flagRequestShortcutWarningDialogSpokenFeedback|
        flagServiceHandlesDoubleTap|
        flagRequestMultiFingerGestures|
        flagRequestOneFingerGestures|
        flagRequestTwoFingerPassthrough"
    
    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <!-- FEEDBACK TYPE - Voice/Haptic feedback                                  -->
    <!-- ═════════════════════════════════════════════════════════════════════ -->
    android:accessibilityFeedbackType="feedbackGeneric|feedbackSpoken|feedbackHaptic|feedbackAudible|feedbackVisual|feedbackAllMask"

    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <!-- NOTIFICATION TIMEOUT - Event frequency control (milliseconds)          -->
    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <!-- 50ms = Ultra-fast response for AI automation                           -->
    android:notificationTimeout="50"

    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <!-- CORE CAPABILITIES - Ye sabse important hai                              -->
    <!-- ═════════════════════════════════════════════════════════════════════ -->
    
    <!-- Screen ka content padh sakta hai (CRITICAL for AI to understand UI) -->
    android:canRetrieveWindowContent="true"
    
    <!-- Screen pe gestures kar sakta hai (tap, swipe, etc.) -->
    android:canPerformGestures="true"
    
    <!-- Keyboard events filter kar sakta hai (typing automation) -->
    android:canRequestFilterKeyEvents="true"
    
    <!-- Accessibility button/shortcut use kar sakta hai -->
    android:canRequestTouchExplorationMode="true"
    
    <!-- Screenshot le sakta hai (Android 11+) -->
    android:canTakeScreenshot="true"
    tools:targetApi="r"
    
    <!-- Display magnification control -->
    android:canControlMagnification="true"
    
    <!-- Brightness control (Android 11+) -->
    android:canControlUiChange="true"
    tools:targetApi="r"
    
    <!-- Wake up screen (Android 12+) -->
    android:canControlDisplays="true"
    tools:targetApi="s"

    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <!-- TIMEOUTS - Auto-hide timing                                            -->
    <!-- ═════════════════════════════════════════════════════════════════════ -->
    
    <!-- Interactive UI elements ka timeout (2 seconds) -->
    android:interactiveUiTimeout="2000"
    
    <!-- Non-interactive UI elements ka timeout (10 seconds) -->
    android:nonInteractiveUiTimeout="10000"

    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <!-- SETTINGS ACTIVITY (Config screen - baad me banayenge)                  -->
    <!-- ═════════════════════════════════════════════════════════════════════ -->
    android:settingsActivity="com.example.jarvis.SettingsActivity"

    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <!-- TARGET PACKAGE NAMES (Optional - empty means all apps)                 -->
    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <!-- Khaali chhoda hai taaki SAARE apps me kaam kare                        -->
    <!-- Agar specific apps ke liye restrict karna hai toh list do:             -->
    <!--                                                                        -->
    <!-- android:packageNames="com.instagram.android,com.google.android.youtube" -->
    <!--                                                                        -->

    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <!-- ADDITIONAL FLAGS - Android 14+ features                                -->
    <!-- ═════════════════════════════════════════════════════════════════════ -->
    tools:ignore="UnusedAttribute"
    
    />